# ===== 服务 =====
# 3000 被占用就改这里（改完前端 dev 代理也要同步改 portal/vite.config.js 的 proxy 目标）
PORT=3000
NODE_ENV=development

# ===== 数据库（默认 SQLite，零外部依赖）=====
# DB_TYPE=sqlite（默认，留空即 sqlite）-> 用 server/data/app.db 文件库，无需装数据库
# DB_TYPE=postgres                       -> 改用下方 PostgreSQL 配置（生产推荐）
DB_TYPE=sqlite
# SQLite 文件路径（仅 sqlite 模式生效，可改绝对路径）
SQLITE_PATH=./data/app.db

# ===== PostgreSQL（仅 DB_TYPE=postgres 时生效）=====
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=admin_scaffold
PG_MAX=10

# ===== JWT =====
# 必填。生产环境务必换成随机长字符串，例如: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret
# token 默认过期秒数（可被 portal_users.session_timeout 覆盖）
TOKEN_TTL=86400

# ===== 初始管理员（首次启动自动创建，可留空关闭）=====
# ⚠️ 上线前务必改掉密码；留空则不创建初始管理员（需要先手动建库插人）
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123456
SEED_ADMIN_NAME=超级管理员

# ===== 邮件（SMTP）=====
# 邮件配置本体存在数据库（后台「系统设置 → 邮件配置」），这里只放两个环境级开关。
# 企业内网自签证书连不上时设为 false；默认严格校验，别轻易关（等于放弃中间人防护）。
# SMTP_TLS_REJECT_UNAUTHORIZED=false
