# ===== 服务 =====
PORT=3000
NODE_ENV=development

# ===== 数据库（默认 SQLite，零外部依赖）=====
# DB_TYPE=sqlite（默认，留空即 sqlite）-> 用 server/data/app.db 文件库，无需装数据库
# DB_TYPE=postgres                       -> 改用下方 PostgreSQL 配置（生产推荐）
DB_TYPE=sqlite
# SQLite 文件路径（仅 sqlite 模式生效，可改绝对路径）
SQLITE_PATH=./data/app.db

# ===== PostgreSQL（仅 DB_TYPE=postgres 时生效）=====
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=admin_scaffold
PG_MAX=10

# ===== JWT =====
# 必填。生产环境务必换成随机长字符串，例如: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret
# token 默认过期秒数（可被 portal_users.session_timeout 覆盖）
TOKEN_TTL=86400

# ===== 初始管理员（首次启动自动创建，可留空关闭）=====
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123456
SEED_ADMIN_NAME=超级管理员
