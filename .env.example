# ===== docker compose 用的环境变量（放仓库根）=====
# 用法：cp .env.example .env，改掉下面三个必填项，然后 docker compose up -d --build
#
# ⚠️ 这是「容器部署」用的；本地 npm start 用的是 server/.env，两者互不干扰。

# 对外暴露的端口（容器内固定 3000，这里改的是宿主端口）
APP_PORT=3000

# ---- 必填 ----
# 生成：openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret
# 初始管理员密码（首次启动自动建号；之后改密码在后台「用户管理」里改）
SEED_ADMIN_PASSWORD=admin123456
# SMTP 密码 / OAuth Secret 的加密密钥。换机器重部署必须保持一致，否则已存的密文解不开。
# 生成：openssl rand -hex 32
SETTINGS_ENC_KEY=change-me-to-another-random-secret

# ---- 可选 ----
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_NAME=超级管理员
TOKEN_TTL=86400

# ---- 数据库 ----
# 默认 sqlite（零依赖，数据落在 app-data 卷）。
# 切 postgres：改成 DB_TYPE=postgres，并用 docker compose --profile postgres up -d --build
DB_TYPE=sqlite
PG_HOST=postgres
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=admin_scaffold
